; ============================================================================
; INJECTION CONDITION
; ============================================================================
; Set these globals before calling this file (see inject.dat):
;   inj_mode  : 'rate' | 'ramp' | 'pressure'
;   inj_value : q_0 [m2/s] | m_q [m2/s2] | DP [Pa]
;
; Then call [injection_start] once. The condition is applied a single time
; with a FISH multiplier f(t) = inj_history, so the applied value is
; inj_value * f(t) at every step (no per-step callback needed).
; ============================================================================

fish define injection_setup
    ; validate the mode and derive what depends on it
    ;   inj_key : HDF5 parameter name of the driver (fracinj.Parameters)
    ;   inj_exp : time exponent of the rate, q(t) ~ t^inj_exp
    global inj_key
    global inj_exp
    if inj_mode = 'rate' then
        inj_key = 'q_0'
        inj_exp = 0
    else if inj_mode = 'ramp' then
        inj_key = 'm_q'
        inj_exp = 1
    else if inj_mode = 'pressure' then
        inj_key = 'DP'
        inj_exp = 0
    else
        system.error = 'inj_mode must be rate, ramp or pressure, got: ' + string(inj_mode)
    endif
end


fish define inj_history
    ; time multiplier of the injection condition: t for the ramp, else 1
    inj_history = 1.0
    if inj_mode = 'ramp' then
        inj_history = fluid.time.total
    endif
end


fish define injection_start
    injection_setup
    if inj_mode = 'pressure' then
        command
            flowknot apply pore-pressure [inj_value] range pos-x 0
        endcommand
    else
        command
            flowplane edge apply discharge [inj_value] fish inj_history range pos-x 0
        endcommand
    endif
end


fish define front_time(x, n)
    ;   time for the front to reach x, no O(1) prefactor
    ;   rate/ramp : x^(n+2) ~ a q^n t^(n(1+i)+1)
    ;   pressure  : x^2     ~ a w_inj^n t,  w_inj = w_i + DP/k_n
    local a = k_n / (12 * mu)
    if inj_mode = 'pressure' then
        front_time = x^2 / (a * (w_i + inj_value / k_n)^n)
    else
        front_time = (x^(n + 2) / (a * inj_value^n)) ^ (1.0 / (n * (1 + inj_exp) + 1))
    endif
end
