program call "scripts/initial.dat"

program threads 24
[global q_0 = 1e-3]
flowplane edge apply discharge [q_0] range pos-x 0

model fluid active on
model mech active on
model mechanical substep 200
model mechanical slave on

; simulation duration
[global T = 50]

program call 'scripts/store_coordinates.py'
fish define store_results
    global fluid_time = fluid.time.total
    command
        program call 'scripts/store_results.py'
    endcommand
end

fish callback add store_results -1 interval-time 0.1 process fluid
model solve fluid time-total [T] mechanical ratio 1e-5
[store_results]

;model save "kn-2000e9"
; injection condition - constant pressure
; [global P_0 = 9e6]
; flowknot apply p-p [P0] range pos-x 0
;model cycle 100
;[global interval = math.floor(0.1/fluid.timestep)]
