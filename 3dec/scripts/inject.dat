program call "scripts/initial.dat"

program threads 12
[global P0 = 9e6]
flowknot apply p-p [P0] range pos-x 0
model fluid active on
model mech active on
model mechanical substep 20 ;2000
model mechanical slave on

program call 'create_files.py'
fish define store_results
    fluidTime = fluid.time.total
    command
        program call 'store_results.py'
    endcommand
end

;model cycle 100
;[global interval = math.floor(0.1/fluid.timestep)]
fish callback add store_results -1 interval-time 0.1 process fluid
model solve fluid time-total 10 mechanical ratio 1e-5
[store_results]
;model save "kn-2000e9"
