; ============================================================
; Geometry, properties, boundary and initial conditions
; ============================================================
;program call "scripts/initial.dat"
model restore "saves/initial.sav"

; ============================================================
; Solver configuration
; ============================================================

program threads 12          ; parallel computing

model fluid      active on  ; fully coupled hydro-mechanical solution
model mechanical active on

; mechanical sub-steps per fluid step (controls coupling accuracy)
model mechanical substep 20
model mechanical slave on

; ============================================================
; Injection condition (x = 0, on the fault) -- see injection.dat
; ============================================================

[global inj_mode  = 'ramp']   ; 'rate' | 'ramp' | 'pressure'
[global inj_value = 1e-8]    ; q_0 [m2/s] | m_q [m2/s2] | DP [Pa]

program call 'scripts/injection.dat'
[injection_start]

; stop when the (soft-regime) diffusion front reaches the fracture end x = L
[global T_fin = 2*front_time(L, 3)]

; ============================================================
; Output
; ============================================================

[global result_dir = "/home/kahmadov/phd/migration/results/3dec/"]
[global filepath = result_dir + inj_mode + "/" + inj_key + "-" + string(inj_value) + ".hdf5"]

; Initialise the HDF5 file and write coordinate arrays and parameters
program call 'scripts/store_coordinates.py'

[global n_store   = 200]
[global t_next    = T_fin / n_store]

fish define store_now
    ; append the current state to the HDF5 file
    global t = fluid.time.total
    command
        program call 'scripts/store_results.py'
    endcommand
end

fish define store_results
    ; callback: store when the fluid time passes the next scheduled time
    global t_next
    local t_now = fluid.time.total
    if t_now < t_next then
        exit
    endif
    store_now
    t_next = t_next + T_fin / n_store
end

; runs after the fluid step (sequence position > 80)
fish callback add store_results 81 process fluid

model solve fluid time-total [T_fin]
;[store_now]
