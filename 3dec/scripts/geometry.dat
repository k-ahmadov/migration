model new 
model deterministic off
model config fluid
model large-strain off

program threads 12

[global L=100]
[global W=2]
block create brick 0 [L] [-W] [W] [-L//2] [L//2]

block cut joint-set dip 0 dip-direction 90 origin 0, 0, 0

block densify segments 5 1 10 join

[global mesh_size_min = 1]
[global mesh_size_int = 2]
[global mesh_size_max = 10]
block zone size edgelength [mesh_size_min] range pos-x 0 [L//5] pos-z [-L//20] [L//20]
block zone size edgelength [mesh_size_int] range pos-x [L//5] [L] pos-z [-L//20] [L//20]
block zone generate-new min-edge [mesh_size_min] max-edge [mesh_size_max] grad-surface 0.3

model save "../saves/geometry"
