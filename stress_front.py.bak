# t_front, x_front = cut_before_boundary(x_front_uncut, t, mesh_size=4)

# %%
plt.figure()
plt.plot(t, np.max(-sn_tx, axis=1) / 1e5, ".")
plt.show()

# %%
plt.figure()
plt.plot(x, -sn_tx[100] / 1e5, ".")
plt.xlabel("x")
plt.ylabel("-sn")
plt.title("tensile stress profile")
plt.tight_layout()
plt.show()


# %%
# -------------------------------------------------------------------
# Importing results of alpha for injection rate effect analysis
# -------------------------------------------------------------------

result_dir = Path.cwd() / "results" / "3dec" / "runs"
files_q0 = [
    result_dir / "run-q-1e-07.hdf5",
    result_dir / "run-q-1e-06.hdf5",
    result_dir / "run-q-1e-05.hdf5",
    result_dir / "run-q-1e-04.hdf5",
    result_dir / "run-q-1e-03.hdf5",
    result_dir / "run-q-1e-02.hdf5",
]

results = []
for fp in files_q0:
    if not fp.exists():
        print(f"Missing: {fp.name}")
        continue
    results.append(analyze_run(fp, mesh_size=4.0))

results = sorted(results, key=lambda d: d["q_0"])
for r in results:
    print(f"{r['file']}: q0={r['q_0']:.1e}  A={r['A']:.4g}  alpha={r['alpha']:.4g}")

