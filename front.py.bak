plt.show()

# %%


class SoftCase:
    def __init__(self, run, stress_peak=True, percentage_of_increase=0.0):
        if stress_peak:
            x_front, idx = find_stress_front(run)
            has_front = slice(0, idx)
        elif percentage_of_increase > 0:
            w_front = constant_w_front(run, percentage_of_increase)
            x_front, has_front = find_aperture_front(run, w_front)
        else:
            print("You must choose one of the front definitions")
            return None

        self.t_front = run.t[has_front]
        self.x_front = x_front

    def analytical_solution_for_front(self):

        time_exponent_analytical = 4 / 5
        M = run.params["k_n"] / (12.0 * run.params["mu"])
        prefactor_analytical = (M * run.params["q_0"] ** 3) ** (1 / 5)

        # empirically (visually) found
        # FIXME: find truely analytical solution

        zeta_front = 1.4
        print(
            np.mean(
                self.x_front[-100:]
                / prefactor_analytical
                * self.t_front[-100:] ** time_exponent_analytical
            )
        )
        x_front_analytical = (
            zeta_front * prefactor_analytical * self.t_front**time_exponent_analytical
        )

        self.zeta_front = zeta_front
        self.x_front_analytical = x_front_analytical

    def empirical(self):
        prefactor, time_exponent = fit_front_power_law(self.t_front, self.x_front)
        self.prefactor = prefactor
        self.time_exponent = time_exponent


