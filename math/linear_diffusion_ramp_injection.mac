
depends(f,x);
ode:'diff(f,x,2)+(x/2)*'diff(f,x,1)+(-3/2)*f = 0;
ode3:diff(ode,x,3);
eq_k:subst(['diff(f,x,5) = 'diff(k,x,2),'diff(f,x,4) = 'diff(k,x,1)],ode3);
sol_k:ode2(eq_k,k,x);
f_dd:integrate(rhs(sol_k),x)+c1;
f_d:integrate(f_dd,x)+c2;
f_gen:integrate(f_d,x)+c3;
a;
res:ratsimp(diff(f_gen,x,2)+(x/2)*diff(f_gen,x)+(-3/2)*f_gen);
eqs:makelist(ratcoef(res,x,n) = 0,n,0,2);
cs:solve(eqs,[c1,c2,c3]);
f_gen:subst(cs[1],f_gen);
ratsimp(diff(f_gen,x,2)+(x/2)*diff(f_gen,x)+(-3/2)*f_gen);
f_c:expand(subst(erf(x/2) = 1-erfc(x/2),f_gen));
grow:subst([erfc(x/2) = 0,%e^(-x^2/4) = 0],f_c);
eq_inf:coeff(grow,x,3) = 0;
eq0:at(diff(f_gen,x),x = 0) = -1;
consts:solve([eq_inf,eq0],[%k1,%k2]);
f_final:subst(consts[1],f_gen);
f_final:expand(subst(erf(x/2) = 1-erfc(x/2),f_final));
ratsimp(diff(f_final,x,2)+(x/2)*diff(f_final,x)+(-3/2)*f_final);
at(diff(f_final,x),x = 0);
limit(f_final,x,inf);
